# Copy this file to .env and fill in your values.

# VisuAI still runs on YOLO alone without them)
OPENAI_API_KEY=
GEMINI_API_KEY=


# Emergency email (optional). For Gmail, create an "app password" in your Google account.
SMTP_USER=
SMTP_PASSWORD=
EMERGENCY_CONTACT=
USER_NAME=
HOME_LOCATION=

# Camera and detection
# CAMERA_INDEX=0
# HORIZONTAL_FOV=70
# YOLO_MODEL=yolov10n.pt
# CONFIDENCE=0.45

# Narration timing (seconds)
# SCENE_CAPTURE_INTERVAL=10
# SUMMARY_INTERVAL=60
